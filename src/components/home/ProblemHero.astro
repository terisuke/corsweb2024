---
import { getCurrentLocale, getTranslations, getLocalizedUrl } from '../../utils/i18n';
import {
  getContactUrl,
  FUKUOKA100_PAGE_URL,
  isFukuoka100EmblemVisible,
} from '../../config/site';
import PenguinWalker from './PenguinWalker.astro';

const currentLocale = getCurrentLocale(Astro.url);
const t = getTranslations(currentLocale);

// 防御的ガード: 万一 i18n に福岡100選のテキスト badge が復活しても、公式エンブレム画像
// （#276）と重複表示しないよう除外する。現在どのロケールにも該当文言は無く実質 no-op。
// 根拠のない倍率バッジは i18n 側で削除済み（ADR-0007）。
const HIDDEN_TRUST_BADGES = ['福岡100選 2026-2027'];
// 公式エンブレムは運営許諾の掲載期間内のみ表示（条件③）。開始日は config/site.ts で管理。
const showFukuoka100Emblem = isFukuoka100EmblemVisible();
const trustBadges = t.homeHero.trustBadges.filter(
  (badge) => !HIDDEN_TRUST_BADGES.includes(badge),
);
// trustBadges の並び（全言語共通）に対応するリンク先。順: ①ローカルLLM ②セキュリティ体制 ③福岡発。
// 対応先が無い index は非リンク（span）で表示。
const BADGE_HREFS: (string | null)[] = [
  '/works/local-llm-poc', // /works は ja 限定（localized variant なし）→ bare のまま
  getLocalizedUrl('/security', currentLocale), // /security は各言語版あり → ロケール別に
  FUKUOKA100_PAGE_URL, // 福岡発バッジ → 100選の特設ページ（エンブレムと同じ遷移先）
];

// CJK（ja/zh/ko）は 7vw で画面幅に自動追従させ、上限に当てない（#302）。
//
// 経緯: 元は clamp(2.15rem,7vw,5.75rem) の上限が 1314px で効き、それ以上いくら画面が広くても
// ヒーローが一切成長しなかった。#298 で 2xl(1536px) に段差を足したが、MacBook 14" の 1512px は
// 段差の 24px 手前で恩恵ゼロ、外部モニター（2164px・実測）も段差の上限 128px で頭打ちのまま
// だった。上限そのものが原因なので、CJK は上限を実質廃止して比率を一定にする。
// 結果、CJK タイトルは画面幅によらず一定比率で表示される（ja 61% / ko 64% / zh 48%）。
//
// 枠（max-w-*）は触らないこと。内側の div は items-center 配下の flex item ＝ 既に shrink-to-fit で、
// h1 は nowrap + text-center。つまり枠の max-width を変えても h1 は同じ位置に着地する
// （ja@2164/3440 でピクセル一致を実測）。CJK には無意味なうえ、枠を広げると 1536〜1888px で
// es の行数が増えて主CTA がファーストビューから落ちる退行を生む。
//
// ラテン系（en/es）は現状維持（#298 時点と同一の値）。タイトルが折り返すため文字を大きくすると
// 行が増え、ヒーローが縦に伸びて主CTA が画面外に落ちる。es@1512x982 の CTA 余白は元から +13px
// しかなく、少しでも育てると破綻する。主CTA は有料入口なので見出しの大きさより優先する。
// en/es を大きくしたいなら、まずタイトルの文言を短くすること（コード側では解けない）。
//
// 15rem(240px) は CJK の安全弁。7vw が 240px に達する 3429px 以上でのみ効く（通常は no-op）。
//
// 注意1: h1 の text-balance は Tailwind 3.4 の機能で、本プロジェクト（3.3.3）では CSS が出ない。
//        折り返しは font-size と枠幅だけで決まる（バージョンを上げるとこの前提が変わる）。
// 注意2: section に overflow-hidden があるため、横溢れは scrollWidth では検知できない（黙って
//        切られる）。検証する場合は行の矩形とビューポートを直接比較すること。
const isCjkLocale = ['ja', 'zh', 'ko'].includes(currentLocale);
const heroTitleSizeClass = isCjkLocale
  ? 'text-[clamp(2.15rem,7vw,15rem)]'
  : 'text-[clamp(2.15rem,7vw,5.75rem)] 2xl:text-[clamp(5.75rem,6vw,6.25rem)]';

// 主CTA: 機密データAI活用診断 / 副: ローカルLLM PoC（ADR-0011）
const primaryHref = getContactUrl(currentLocale, {
  intent: 'confidential-ai-assessment',
  source: 'home-hero',
});
const secondaryHref = getContactUrl(currentLocale, {
  intent: 'local-llm-poc',
  source: 'home-hero',
});
---

<section class="relative isolate flex min-h-[88vh] items-center overflow-hidden pt-20 pb-32 sm:pt-28 sm:pb-36">
  {/* 抽象モーション背景（装飾・読み上げ対象外）。prefers-reduced-motion で静止。 */}
  <div class="motion-bg" aria-hidden="true"></div>
  {/* 2xl(≥1536px) の枠の上乗せは #298 の名残。h1 は shrink-to-fit + nowrap + text-center の
      ため、この枠は h1 の見た目には影響しない（heroTitleSizeClass のコメント参照）。効くのは
      枠内で折り返す要素＝字幕・CTA・バッジ側。h1 の頭打ちは heroTitleSizeClass で解消済みで、
      1314px の上限が残るのはラテン系（en/es）だけ。 */}
  <div class="relative z-10 mx-auto w-full max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8 2xl:max-w-[90rem]">
    <div class="flex flex-col items-center gap-8 text-center sm:gap-10" data-hero-content>
      <p
        class="text-sm font-medium uppercase tracking-widest text-primary-600 dark:text-primary-400"
        data-reveal
        style="--reveal-delay:0.05s"
      >
        {t.homeHero.kicker}
      </p>
      <div class="flex max-w-5xl flex-col items-center gap-6 sm:gap-8 2xl:max-w-7xl">
        {/* 巨大タイポ＝「視覚で止まる」主役。即描画(LCP死守)のため演出は付けない。
            サイズは heroTitleSizeClass が全て持つ（ベタ書きの text-[...] を足すと、後勝ちが
            クラス属性の順ではなく CSS の出力順で決まるため、無言で競合する）。 */}
        <h1
          class={`text-balance font-semibold leading-[1.05] tracking-tight ${heroTitleSizeClass}`}
          set:html={t.homeHero.title}
        />
        {/* 2xl では列幅だけ広げ、文字サイズは上げない。theme.fontSize が [size, lineHeight] の
            タプル指定のため text-2xl は line-height:2rem も出し、後勝ちで leading-relaxed(1.625) を
            打ち消してしまう（20px/1.70 → 24px/1.33 と字間が詰まって逆に読みにくくなる）。
            2xl:leading-relaxed で戻すと es の主CTA が 1920×950 でファーストビュー外に落ちる。 */}
        <p class="max-w-3xl text-pretty text-lg leading-relaxed text-primary-950/70 dark:text-primary-200/70 sm:text-xl 2xl:max-w-4xl" set:html={t.homeHero.subtitle} data-reveal style="--reveal-delay:0.15s"></p>
      </div>
      <div class="flex w-full flex-col items-center gap-4 sm:w-auto sm:flex-row sm:justify-center" data-reveal style="--reveal-delay:0.3s">
        {/* 有料入口: 診断（主）+ ローカルLLM PoC（副）。Grift は GriftBridge / ServiceCtas 側（ADR-0011）。 */}
        <a
          href={primaryHref}
          class="inline-flex min-h-[48px] w-full max-w-sm items-center justify-center rounded-full border border-transparent bg-[#2d4a6b] px-6 py-4 text-center text-lg font-semibold text-white shadow-sm transition hover:bg-[#1e3350] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2d4a6b] sm:w-auto sm:px-8"
        >
          {t.homeHero.primaryCta}
        </a>
        <a
          href={secondaryHref}
          class="inline-flex min-h-[48px] w-full max-w-sm items-center justify-center rounded-full px-5 py-3 text-center text-base font-medium text-primary-950 underline-offset-4 transition hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:text-primary-200 sm:w-auto"
        >
          {t.homeHero.secondaryCta}
        </a>
      </div>
      {
        trustBadges.length > 0 && (
          <ul class="flex flex-wrap items-center justify-center gap-3" data-reveal style="--reveal-delay:0.45s">
            {trustBadges.map((badge, i) => {
              const href = BADGE_HREFS[i];
              const isExternal = Boolean(href && href.startsWith('http'));
              const pill = 'inline-flex rounded-full bg-primary-500/10 px-4 py-1.5 text-sm text-primary-950/70 dark:bg-primary-400/10 dark:text-primary-200/70';
              return (
                <li>
                  {href ? (
                    <a
                      href={href}
                      target={isExternal ? '_blank' : undefined}
                      rel={isExternal ? 'noopener noreferrer' : undefined}
                      class={`${pill} transition hover:bg-primary-500/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:hover:bg-primary-400/20`}
                    >
                      {badge}
                    </a>
                  ) : (
                    <span class={pill}>{badge}</span>
                  )}
                </li>
              );
            })}
          </ul>
        )
      }
      {
        showFukuoka100Emblem && (
          /* 福岡を代表する企業100選 公式エンブレム（#276・運営許諾取得済み）。
             条件②によりクリックで選出企業の特設ページへ遷移させる。
             ライト＝通常版 / ダーク＝白版を出し分け（提供素材）。 */
          /* アクセシブル名は <a> の aria-label で持つ。ライト/ダークで一方の <img> が
             display:none になるため、alt に名前を持たせるとダーク時に名前が消える。 */
          <a
            href={FUKUOKA100_PAGE_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t.homeHero.fukuoka100Alt}
            class="inline-flex rounded-lg transition hover:opacity-80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-600"
            data-reveal
            style="--reveal-delay:0.5s"
          >
            {/* loading="lazy" は必須: display:none 側の先読み取得を防ぎ、表示中の1枚だけを取得させる。
                eager にすると両方ダウンロードされるため変更しないこと。 */}
            <img
              src="/assets/badges/fukuoka100-emblem-wide.png"
              alt=""
              aria-hidden="true"
              width="480"
              height="120"
              loading="lazy"
              decoding="async"
              class="h-11 w-auto dark:hidden sm:h-12"
            />
            <img
              src="/assets/badges/fukuoka100-emblem-wide-white.png"
              alt=""
              aria-hidden="true"
              width="480"
              height="120"
              loading="lazy"
              decoding="async"
              class="hidden h-11 w-auto dark:block sm:h-12"
            />
          </a>
        )
      }
      {/* ファーストビュー直下の補助文（#175）: 事業内容を一文で補足する控えめなライン。 */}
      <p
        class="max-w-3xl text-pretty text-sm leading-relaxed text-primary-950/60 dark:text-primary-200/60 sm:text-base"
        data-reveal
        style="--reveal-delay:0.55s"
      >
        {t.homeHero.support}
      </p>
    </div>
  </div>
  {/* ロゴのペンギンがヒーロー下部を歩く演出（装飾）。クリックで飛び立ち、下から再登場。 */}
  <PenguinWalker bubble={t.homeHero.penguinBubble} locale={currentLocale} />
  {/* 「↓」スクロールヒント: 下に続きがあると気づかせ離脱を防ぐ。少しスクロールで消える。 */}
  <div class="scroll-hint pointer-events-none absolute inset-x-0 bottom-8 z-10 flex justify-center" aria-hidden="true">
    <span class="scroll-hint-arrow text-2xl text-primary-950/40 dark:text-primary-200/40">↓</span>
  </div>
</section>
