---
import { type CollectionEntry, getCollection } from 'astro:content';
import NewsArticle from '../../components/news/NewsArticle.astro';
import Layout from '../../layouts/Layout.astro';
import { toCleanSlug } from '../../utils/content-i18n';
import { getJaTranslations } from '../../utils/i18n';

// ja のニュース記事。記事は news/ja/<slug>.md に置かれ slug が `ja/<slug>` になるため、
// 公開 URL では接頭辞を外す（既存の /news/<slug> を維持する）。
// externalUrl 付きの記事は外部へ飛ばすため詳細ページを生成しない。
export async function getStaticPaths() {
  const news = await getCollection('news', ({ data }) => {
    return data.lang === 'ja' && (import.meta.env.DEV || !data.isDraft) && !data.externalUrl;
  });

  return news.map((entry) => ({
    params: { slug: toCleanSlug(entry.slug) },
    props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'news'>;
};

const { entry } = Astro.props as Props;
const data = entry.data;
const t = getJaTranslations();
---

<Layout
  title={`${data.title}${t.news.titleSuffix}`}
  description={data.description}
  availableLocales={['ja', 'en', 'zh', 'ko', 'es']}
  ogImage={data.ogImage}
  ogType="article"
  publishedTime={data.publishedAt.toISOString()}
  modifiedTime={data.updatedAt?.toISOString()}
>
  <NewsArticle entry={entry} />
</Layout>
