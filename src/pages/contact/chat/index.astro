---
import Layout from '../../../layouts/Layout.astro';
import { getCurrentLocale, getLocalizedUrl, getTranslations } from '../../../utils/i18n';

const queryLocale = Astro.url.searchParams.get('locale');
const currentLocale = queryLocale === 'en' ? 'en' : getCurrentLocale(Astro.url);
const t = getTranslations(currentLocale);
const contactUrl = getLocalizedUrl('/contact/', currentLocale);
const copy = currentLocale === 'ja'
  ? {
      title: 'AIチャットを準備しています',
      // 通常時フォームは出さないため、実在する手段（電話・日程調整）へ送る。
      body: 'Cloudiaを開けない場合は、お電話または日程調整からご連絡ください。',
      link: 'お問い合わせページを開く',
    }
  : {
      title: 'The AI chat is unavailable',
      body: 'If Cloudia cannot be opened, please call us or schedule a meeting.',
      link: 'Open the contact page',
    };
---

{/* analytics=false: このページは Cloudia ランチャーから iframe 読み込みされるため、
    計測タグを出すと同一訪問者に対し Clarity が二重に起動し、幻の /contact/chat/ セッションで
    解析データが汚れる（SSG のため embed=1 クエリはビルド時に判定できず、ここで明示的に落とす）。 */}
<Layout
  description={copy.body}
  title={copy.title}
  availableLocales={['ja', 'en']}
  cloudiaLauncher={false}
  analytics={false}
>
  <main class="mx-auto flex min-h-[50vh] max-w-2xl flex-col items-center justify-center gap-5 px-4 py-20 text-center sm:px-6">
    <h1 class="text-3xl font-medium tracking-tight sm:text-4xl">{copy.title}</h1>
    <p class="max-w-lg text-base leading-relaxed text-primary-950/70 dark:text-primary-200/70">{copy.body}</p>
    <a
      href={contactUrl}
      class="inline-flex min-h-[3rem] items-center justify-center rounded-full bg-primary-600 px-6 py-3 text-sm font-semibold text-white hover:bg-primary-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:bg-primary-400 dark:text-primary-950 dark:hover:bg-primary-300"
    >{copy.link}</a>
  </main>
</Layout>
