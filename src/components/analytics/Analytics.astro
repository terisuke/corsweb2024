---
// 計測タグ（#51）。env で gate し、トークン / ID が設定されている時のみ読み込む。
// - Cloudflare Web Analytics: PUBLIC_CF_BEACON_TOKEN（Cloudflare ダッシュボードのビーコントークン）
// - Microsoft Clarity:        PUBLIC_CLARITY_ID（clarity.microsoft.com のプロジェクトID）
//
// どちらも未設定なら何も出力しない（dev / 未設定環境では計測ゼロ）。
// プライバシー: これらは解析ツールのため、プライバシーポリシーでの開示が必要（#49 で対応）。
// Clarity は Microsoft（米国）への送信となるため越境の開示も #49 / 弁護士確認の範囲。
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN ?? '';
const clarityId = import.meta.env.PUBLIC_CLARITY_ID ?? '';
---

{
  cfBeaconToken && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
    />
  )
}

{
  clarityId && (
    <script is:inline define:vars={{ clarityId }}>
      (function (c, l, a, r, i) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        var t = l.createElement(r);
        t.async = 1;
        t.src = 'https://www.clarity.ms/tag/' + i;
        var y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', clarityId);
    </script>
  )
}
