---
import Layout from '../layouts/Layout.astro';
import NextStep from '../components/common/NextStep.astro';
import { getCurrentLocale, getLocalizedUrl, getTranslations } from '../utils/i18n';

const currentLocale = getCurrentLocale(Astro.url);
const t = getTranslations(currentLocale);
---

<Layout
  description={t.meta.security.description}
  title={t.meta.security.title}
>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="flex flex-col gap-4 pb-16 text-start sm:pb-20">
      <h1 class="type-heading text-3xl font-medium tracking-tight sm:text-4xl md:text-5xl">{t.security.title}</h1>
      <p class="type-copy text-base italic text-primary-950/70 dark:text-primary-200/70">{t.security.tagline}</p>
    </div>
    <div class="type-copy text-base leading-[1.8]">
      <p class="mb-4">
        {t.security.lead}
      </p>

      <section>
        <h2 class="type-heading mb-6 mt-12 text-xl font-medium sm:text-2xl">{t.security.basicPolicy.title}</h2>
        {
          t.security.basicPolicy.note && (
            <p class="mb-6 rounded-md border border-primary-900/15 bg-primary-900/[0.03] px-4 py-3 text-sm dark:border-primary-300/15 dark:bg-primary-300/[0.04]">
              {t.security.basicPolicy.note}
            </p>
          )
        }
        {
          Array.isArray(t.security.basicPolicy.preamble) &&
            t.security.basicPolicy.preamble.map((para) => <p class="mb-4">{para}</p>)
        }
        <h3 class="type-heading mb-4 mt-8 text-lg font-medium">{t.security.basicPolicy.guidelinesTitle}</h3>
        <ol class="list-outside list-decimal space-y-3 pl-6">
          {
            Array.isArray(t.security.basicPolicy.guidelines) &&
              t.security.basicPolicy.guidelines.map((item) => <li>{item}</li>)
          }
        </ol>
        <div class="mt-8 text-end">
          <p>{t.security.basicPolicy.signatureDate}</p>
          <p class="mt-1">{t.security.basicPolicy.signatureCompany}</p>
          <p class="mt-1 font-medium">{t.security.basicPolicy.signatureName}</p>
        </div>
        <p class="mt-6 text-sm text-primary-950/50 dark:text-primary-200/50">{t.security.basicPolicy.meta}</p>
      </section>

      <h2 class="type-heading mb-6 mt-12 text-xl font-medium sm:text-2xl">{t.security.pillarsTitle}</h2>
      <div class="flex flex-col gap-8">
        {
          Array.isArray(t.security?.pillars) && t.security.pillars.map((pillar) => (
            <div>
              <h3 class="type-heading mb-2 text-lg font-medium">{pillar.title}</h3>
              <p>{pillar.description}</p>
            </div>
          ))
        }
      </div>

      <h2 class="type-heading mb-6 mt-12 text-xl font-medium sm:text-2xl">{t.security.aiTitle}</h2>
      <p class="mb-4">{t.security.aiDescription}</p>

      <h2 class="type-heading mb-6 mt-12 text-xl font-medium sm:text-2xl">{t.security.governanceTitle}</h2>
      <p class="mb-4">{t.security.governanceDescription}</p>

      <h2 class="type-heading mb-6 mt-12 text-xl font-medium sm:text-2xl">{t.security.tableTitle}</h2>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left text-sm sm:text-base">
          <thead>
            <tr class="border-b border-primary-900/20 dark:border-primary-300/20">
              <th class="py-3 pr-4 font-medium">{t.security.tableHead.area}</th>
              <th class="py-3 pr-4 font-medium">{t.security.tableHead.effort}</th>
              <th class="py-3 font-medium">{t.security.tableHead.state}</th>
            </tr>
          </thead>
          <tbody>
            {
              Array.isArray(t.security?.table) && t.security.table.map((row) => (
                <tr class="border-b border-primary-900/10 dark:border-primary-300/10 align-top">
                  <td class="py-3 pr-4 font-medium">{row.area}</td>
                  <td class="py-3 pr-4">{row.effort}</td>
                  <td class="py-3 whitespace-nowrap">{row.state}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2 class="type-heading mb-6 mt-12 text-xl font-medium sm:text-2xl">{t.security.privacyTitle}</h2>
      <p class="mb-2 text-sm text-primary-950/50 dark:text-primary-200/50">{t.security.privacyLead}</p>
      <p class="mb-4">
        {t.security.privacyDescription}<span class="font-medium"><a href={getLocalizedUrl('/privacy', currentLocale)}>{t.security.privacyLinkText}</a></span>{t.security.privacySuffix}
      </p>
    </div>
  </div>

  <NextStep
    heading={t.nextStep.security.heading}
    ctas={[
      { label: t.security.ctas.primary, href: getLocalizedUrl('/contact', currentLocale), primary: true },
      { label: t.security.ctas.secondary, href: getLocalizedUrl('/contact', currentLocale) },
      { label: t.security.ctas.tertiary, href: getLocalizedUrl('/privacy', currentLocale) }
    ]}
  />
</Layout>
