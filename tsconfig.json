{
  "compilerOptions": {
    "typeRoots": ["./node_modules/@types", "./types", "./src"],
    "types": ["types"],
    "module": "ES2022",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ]
  },
  "exclude": ["node_modules", "dist", ".astro", "workers"]
}
