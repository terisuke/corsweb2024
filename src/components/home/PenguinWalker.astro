---
import type { Locale } from '../../utils/i18n';

interface Props {
  bubble: string[];
  locale: Locale;
}

const { bubble, locale } = Astro.props;

// マスコットの aria-label（ページ言語に合わせる）。吹き出しとは別に軽量に持つ。
const ARIA: Record<string, string> = {
  ja: 'マスコットのペンギン。タップすると飛び立ちます',
  en: 'Mascot penguin. Tap to make it fly',
  zh: '吉祥物企鹅。点击后会飞起来',
  ko: '마스코트 펭귄. 탭하면 날아오릅니다',
  es: 'Pingüino mascota. Tócalo para hacerlo volar',
};
const ariaLabel = ARIA[locale] ?? ARIA.ja;
---

{/* ロゴのペンギンがヒーロー下部を歩く演出（装飾）。動画不使用・SVG＋CSS＋軽量JSのみ。 */}
<div class="pw-layer" aria-hidden="false">
  <div
    class="pw is-walking"
    id="pw-mascot"
    role="button"
    tabindex="0"
    aria-label={ariaLabel}
    data-bubble={JSON.stringify(bubble)}
  >
    <div class="pw-bubble" aria-hidden="true"><span class="pw-btxt"></span></div>
    <div class="pw-rot"><div class="pw-flip"><div class="pw-bob">
      <svg viewBox="0 0 120 152" width="100%" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          <linearGradient id="pw-body" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#234b74"></stop><stop offset="1" stop-color="#0d2438"></stop>
          </linearGradient>
          <linearGradient id="pw-belly" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffffff"></stop><stop offset="1" stop-color="#e4ecf2"></stop>
          </linearGradient>
          <linearGradient id="pw-scarf" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#4cbbdf"></stop><stop offset="1" stop-color="#2c90b8"></stop>
          </linearGradient>
          <linearGradient id="pw-amber" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#eeb662"></stop><stop offset="1" stop-color="#cf8a37"></stop>
          </linearGradient>
        </defs>

        <ellipse cx="60" cy="146" rx="28" ry="5" fill="#0a1420" opacity="0.20"></ellipse>

        <g class="pw-streaks" stroke="#5cc6e6" stroke-width="4.5" stroke-linecap="round">
          <path d="M26 60 H-4" opacity=".9"></path>
          <path d="M22 78 H-14" opacity=".7"></path>
          <path d="M28 96 H-2" opacity=".55"></path>
        </g>

        <g fill="url(#pw-amber)">
          <rect class="pw-foot pw-foot-l" x="40" y="133" width="20" height="12" rx="6"></rect>
          <rect class="pw-foot pw-foot-r" x="60" y="133" width="20" height="12" rx="6"></rect>
        </g>

        <path class="pw-wing pw-wing-l" d="M34 56 C21 62 19 90 28 102 C32 106 37 104 37 97 C36 82 37 68 41 60 C39 56 35 55 34 56 Z" fill="#123351"></path>
        <path class="pw-wing pw-wing-r" d="M86 56 C99 62 101 90 92 102 C88 106 83 104 83 97 C84 82 83 68 79 60 C81 56 85 55 86 56 Z" fill="#123351"></path>

        <path d="M60 17 C85 17 92 49 92 82 C92 118 80 138 60 138 C40 138 28 118 28 82 C28 49 35 17 60 17 Z" fill="url(#pw-body)"></path>

        <path d="M37 44 C43 33 52 28 60 27" fill="none" stroke="#66cbe8" stroke-width="3.4" stroke-linecap="round" opacity="0.5"></path>

        <path d="M60 34 C75 34 83 53 83 80 C83 108 72 128 60 128 C48 128 37 108 37 80 C37 53 45 34 60 34 Z" fill="url(#pw-belly)"></path>

        <g>
          <ellipse cx="50" cy="56" rx="5.2" ry="6" fill="#12283f"></ellipse>
          <ellipse cx="70" cy="56" rx="5.2" ry="6" fill="#12283f"></ellipse>
          <circle cx="51.6" cy="54" r="1.6" fill="#fff"></circle>
          <circle cx="71.6" cy="54" r="1.6" fill="#fff"></circle>
          <path class="pw-lid" d="M44 54 q6 -3.5 12 0" fill="none" stroke="#12283f" stroke-width="3.2" stroke-linecap="round"></path>
          <path class="pw-lid" d="M64 54 q6 -3.5 12 0" fill="none" stroke="#12283f" stroke-width="3.2" stroke-linecap="round"></path>
        </g>

        <path d="M60 63 l6.5 5.5 -6.5 5 -6.5 -5 z" fill="url(#pw-amber)"></path>

        <path d="M38 84 C48 92 72 92 82 84 C84 89 84 94 82 98 C72 104 48 104 38 98 C36 94 36 89 38 84 Z" fill="url(#pw-scarf)"></path>
        <path class="pw-scarf-tail" d="M78 96 C88 98 93 109 90 122 C88 128 82 128 81 122 C80 113 78 105 76 100 Z" fill="url(#pw-scarf)"></path>
      </svg>
    </div></div></div>
  </div>
</div>

<style>
  .pw-layer {
    position: absolute; inset: 0; z-index: 14; overflow: hidden; pointer-events: none;
  }
  .pw {
    position: absolute; left: 0; top: 0;
    width: clamp(66px, 10vw, 88px); height: auto;
    cursor: pointer; pointer-events: auto; will-change: transform;
    -webkit-tap-highlight-color: transparent;
    filter: drop-shadow(0 10px 12px rgba(10, 20, 35, .26));
    transform: translate3d(0, 0, 0);
  }
  .pw:focus-visible { outline: 3px solid #3fb0d4; outline-offset: 6px; border-radius: 20px; }
  .pw-rot { transform-origin: 50% 82%; transition: transform .2s ease; }
  .pw-flip { transform-origin: 50% 50%; }
  .pw-bob { transform-origin: 50% 92%; }

  .pw.is-walking .pw-bob { animation: pw-waddle .66s ease-in-out infinite; }
  @keyframes pw-waddle {
    0%, 100% { transform: rotate(-4deg); }
    25% { transform: rotate(0deg) translateY(-2.5px); }
    50% { transform: rotate(4deg); }
    75% { transform: rotate(0deg) translateY(-2.5px); }
  }
  .pw.is-squash .pw-bob { transform: translateY(7px) scale(1.12, .82); transition: transform .12s ease; }

  .pw-foot { transform-box: fill-box; transform-origin: center; }
  .pw.is-walking .pw-foot-l { animation: pw-stepA .66s ease-in-out infinite; }
  .pw.is-walking .pw-foot-r { animation: pw-stepB .66s ease-in-out infinite; }
  @keyframes pw-stepA { 0%, 100% { transform: translateY(0) rotate(0); } 50% { transform: translateY(-5px) rotate(-8deg); } }
  @keyframes pw-stepB { 0%, 100% { transform: translateY(-5px) rotate(8deg); } 50% { transform: translateY(0) rotate(0); } }

  .pw-wing { transform-box: fill-box; transition: transform .35s cubic-bezier(.4, 0, .3, 1); }
  .pw-wing-l { transform-origin: 78% 12%; }
  .pw-wing-r { transform-origin: 22% 12%; }
  .pw.is-walking .pw-wing-l { animation: pw-flapA .66s ease-in-out infinite; }
  .pw.is-walking .pw-wing-r { animation: pw-flapB .66s ease-in-out infinite; }
  @keyframes pw-flapA { 0%, 100% { transform: rotate(6deg); } 50% { transform: rotate(-4deg); } }
  @keyframes pw-flapB { 0%, 100% { transform: rotate(-6deg); } 50% { transform: rotate(4deg); } }

  .pw-scarf-tail { transform-box: fill-box; transform-origin: 20% 10%; }
  .pw.is-walking .pw-scarf-tail { animation: pw-flutter .66s ease-in-out infinite; }
  @keyframes pw-flutter { 0%, 100% { transform: rotate(-5deg); } 50% { transform: rotate(9deg); } }

  .pw.is-flying .pw-wing-l { transform: rotate(58deg) translate(-2px, -4px); }
  .pw.is-flying .pw-wing-r { transform: rotate(-58deg) translate(2px, -4px); }
  .pw.is-flying .pw-scarf-tail { transform: rotate(46deg) scaleY(1.35); }
  .pw-streaks { opacity: 0; transition: opacity .18s ease; }
  .pw.is-flying .pw-streaks { opacity: 1; animation: pw-zoom .28s linear infinite; }
  @keyframes pw-zoom { from { transform: translateX(6px); } to { transform: translateX(-8px); } }
  .pw-lid { opacity: 0; transition: opacity .15s ease; }
  .pw.is-flying .pw-lid { opacity: 1; }

  .pw.is-peek .pw-bob { animation: pw-peek 1s ease-in-out infinite; }
  @keyframes pw-peek { 0%, 100% { transform: rotate(-4deg); } 50% { transform: rotate(4deg); } }

  /* speech bubble */
  .pw-bubble {
    position: absolute; left: 50%; bottom: calc(100% - 4px); transform: translateX(-50%);
    background: #ffffff; color: #1c1917; border: 1px solid rgba(29, 26, 23, .12);
    border-radius: 14px; padding: 6px 12px; font-size: .8rem; font-weight: 600; line-height: 1;
    white-space: nowrap; box-shadow: 0 8px 20px rgba(10, 20, 35, .18);
    opacity: 0; transition: opacity .3s ease; pointer-events: none;
  }
  .pw-bubble::after {
    content: ""; position: absolute; left: 50%; bottom: -6px; width: 12px; height: 12px;
    background: #ffffff; border-right: 1px solid rgba(29, 26, 23, .12); border-bottom: 1px solid rgba(29, 26, 23, .12);
    transform: translateX(-50%) rotate(45deg);
  }
  :global(html.dark) .pw-bubble { background: #201e18; color: #f4f2ee; border-color: rgba(244, 242, 238, .14); }
  :global(html.dark) .pw-bubble::after { background: #201e18; border-color: rgba(244, 242, 238, .14); }
  .pw-btxt { display: inline-block; transition: opacity .22s ease, transform .22s ease; }
  .pw-bubble.swap .pw-btxt { opacity: 0; transform: translateY(-3px); }
  .pw.is-walking .pw-bubble { opacity: 1; animation: pw-bubbob 2.4s ease-in-out infinite; }
  @keyframes pw-bubbob { 0%, 100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(-3px); } }
  .pw.no-bubble .pw-bubble, .pw.edge .pw-bubble { opacity: 0 !important; }

  @media (prefers-reduced-motion: reduce) {
    .pw, .pw * { animation: none !important; transition: none !important; }
  }
</style>

<script>
  function initPenguin() {
    const peng = document.getElementById('pw-mascot');
    if (!peng || peng.dataset.pwReady) return;
    peng.dataset.pwReady = '1';

    // 前ページの残存ループを止める（View Transitions 対策）
    const w = window as any;
    if (w.__pwRaf) cancelAnimationFrame(w.__pwRaf);
    if (w.__pwTimer) clearInterval(w.__pwTimer);
    if (w.__pwRO) { try { w.__pwRO.disconnect(); } catch (e) { /* noop */ } }

    const layer = peng.parentElement as HTMLElement;
    const rot = peng.querySelector('.pw-rot') as HTMLElement;
    const flip = peng.querySelector('.pw-flip') as HTMLElement;
    const bubble = peng.querySelector('.pw-bubble') as HTMLElement;
    const btxt = peng.querySelector('.pw-btxt') as HTMLElement;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    let messages: string[] = ['ようこそ！', 'タップしてみてね！'];
    try { const parsed = JSON.parse(peng.dataset.bubble || '[]'); if (Array.isArray(parsed) && parsed.length) messages = parsed; } catch (e) { /* keep default */ }

    let W = 0, H = 0, PW = 0, PH = 0, floorY = 0, margin = 40;
    const bubbleHalf = 78;
    let x = 60, dir = 1, state = 'walk', facing = 1, lastT = 0, bi = 0;
    const speed = 42;

    function measure() {
      const r = layer.getBoundingClientRect();
      W = r.width; H = r.height; PW = peng.offsetWidth; PH = peng.offsetHeight;
      // ヒーローは 88vh より高くなる場合があるため、床は「初期ビューポート下端」に合わせて常に見える位置に。
      const layerTopDoc = r.top + window.scrollY;
      const viewFloor = (window.innerHeight - 18) - layerTopDoc - PH;
      const hi = H - PH - 12;
      const lo = Math.min(hi, H * 0.5);
      floorY = clamp(viewFloor, lo, hi);
      margin = Math.min(44, W * 0.1);
    }
    function setPos(px: number, py: number) { peng.style.transform = 'translate3d(' + px + 'px,' + py + 'px,0)'; }
    function face(d: number) { facing = d; flip.style.transform = 'scaleX(' + d + ')'; }
    function clamp(v: number, a: number, b: number) { return v < a ? a : (v > b ? b : v); }

    function walkFrame(t: number) {
      if (state !== 'walk') return;
      if (!lastT) lastT = t;
      const dt = Math.min((t - lastT) / 1000, 0.05); lastT = t;
      x += dir * speed * dt;
      const maxX = W - PW - margin;
      if (x >= maxX) { x = maxX; dir = -1; face(-1); }
      else if (x <= margin) { x = margin; dir = 1; face(1); }
      setPos(x, floorY);
      const bc = x + PW / 2;
      peng.classList.toggle('edge', (bc - bubbleHalf < 2 || bc + bubbleHalf > W - 2));
      w.__pwRaf = requestAnimationFrame(walkFrame);
    }
    function startWalk() {
      state = 'walk';
      peng.classList.remove('is-flying', 'is-squash', 'is-peek', 'no-bubble');
      peng.classList.add('is-walking');
      rot.style.transition = 'none'; rot.style.transform = 'rotate(0deg)';
      peng.style.transition = 'none';
      setPos(x, floorY); lastT = 0;
      if (w.__pwRaf) cancelAnimationFrame(w.__pwRaf);
      w.__pwRaf = requestAnimationFrame(walkFrame);
    }
    function launch() {
      if (state !== 'walk') return;
      state = 'launch';
      if (w.__pwRaf) cancelAnimationFrame(w.__pwRaf);
      peng.classList.remove('is-walking', 'edge');
      peng.classList.add('is-squash', 'no-bubble');
      setTimeout(fly, 150);
    }
    function fly() {
      state = 'fly';
      peng.classList.remove('is-squash');
      peng.classList.add('is-flying');
      const flyDir = facing;
      const targetX = clamp(x + flyDir * (W * 0.28), -60, W - PW + 60);
      rot.style.transition = 'transform .8s cubic-bezier(.42,0,.4,1)';
      rot.style.transform = 'rotate(' + (flyDir * -20) + 'deg)';
      peng.style.transition = 'transform .8s cubic-bezier(.45,0,.25,1)';
      setPos(targetX, -PH - 60);
      setTimeout(sprout, 880);
    }
    function sprout() {
      state = 'sprout';
      peng.classList.remove('is-flying');
      const cx = clamp(W / 2 - PW / 2 + (facing < 0 ? -1 : 1) * W * 0.14, margin, W - PW - margin);
      peng.style.transition = 'none'; rot.style.transition = 'none'; rot.style.transform = 'rotate(0deg)';
      face(1);
      setPos(cx, H + 24);
      void peng.offsetWidth;
      peng.style.transition = 'transform .62s cubic-bezier(.34,1.5,.5,1)';
      setPos(cx, floorY);
      peng.classList.add('is-peek');
      x = cx;
      setTimeout(function () { peng.classList.remove('is-peek'); startWalk(); }, 1050);
    }

    function swapBubble() {
      if (state !== 'walk') return;
      bi = 1 - bi;
      bubble.classList.add('swap');
      setTimeout(function () { btxt.textContent = messages[bi] || ''; bubble.classList.remove('swap'); }, 230);
    }

    peng.addEventListener('click', launch);
    peng.addEventListener('keydown', function (e: KeyboardEvent) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); launch(); }
    });

    let rT: number | undefined;
    window.addEventListener('resize', function () {
      clearTimeout(rT);
      rT = window.setTimeout(function () {
        const wasWalking = state === 'walk'; measure();
        x = clamp(x, margin, W - PW - margin);
        if (wasWalking) setPos(x, floorY);
      }, 150);
    });
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) { if (w.__pwRaf) cancelAnimationFrame(w.__pwRaf); }
      else if (state === 'walk') { lastT = 0; w.__pwRaf = requestAnimationFrame(walkFrame); }
    });

    // init
    btxt.textContent = messages[0] || '';

    // レイアウト確定後にサイズを取り直し、床位置ズレを防ぐ（初回描画・フォント適用・回転などに追従）。
    function reflow() {
      measure();
      x = clamp(x, margin, W - PW - margin);
      if (state === 'walk') setPos(x, floorY);
    }
    try { w.__pwRO = new ResizeObserver(reflow); w.__pwRO.observe(layer); } catch (e) { /* RO 無しでも下記で動く */ }

    requestAnimationFrame(function () {
      measure();
      if (reduce.matches) {
        peng.classList.remove('is-walking');
        x = Math.round(W * 0.16); face(1); setPos(x, floorY);
        btxt.textContent = messages[1] || messages[0] || '';
        bubble.style.opacity = '1';
        return;
      }
      x = clamp(x, margin, W - PW - margin);
      startWalk();
      w.__pwTimer = window.setInterval(swapBubble, 3000);
    });
  }

  document.addEventListener('astro:page-load', initPenguin);
  if (document.readyState !== 'loading') initPenguin();
</script>
