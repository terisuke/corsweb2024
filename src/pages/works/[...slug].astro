---
import { type CollectionEntry, getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import CaseArticle from '../../components/works/CaseArticle.astro'
import { toCleanSlug } from '../../utils/content-i18n'
import { getJaTranslations } from '../../utils/i18n'

// /works/<slug> の実績記事テンプレート（ja）。/works（index）とはルートが衝突しない。
// 記事は cases/ja/<slug>.md に置かれ slug が `ja/<slug>` になるため、公開 URL では接頭辞を外す。
// 本番ビルドでは下書き（isDraft）を除外。dev では下書きも表示して執筆中プレビューを可能にする。
export async function getStaticPaths() {
  const cases = await getCollection('cases', ({ data }) => {
    return data.lang === 'ja' && (import.meta.env.DEV || !data.isDraft)
  })

  return cases.map((entry) => ({
    params: { slug: toCleanSlug(entry.slug) },
    props: { entry },
  }))
}

type Props = {
  entry: CollectionEntry<'cases'>
}

const { entry } = Astro.props as Props
const data = entry.data
const t = getJaTranslations()
// OG画像: ogImage 優先、なければ heroImage。
const ogImageUrl = data.ogImage ?? data.heroImage?.url
---

<Layout
  title={`${data.title}${t.caseStudy.titleSuffix}`}
  description={data.description}
  availableLocales={['ja', 'en', 'zh', 'ko', 'es']}
  ogImage={ogImageUrl}
  ogType="article"
  publishedTime={data.publishedAt.toISOString()}
  modifiedTime={data.updatedAt?.toISOString()}
>
  <CaseArticle entry={entry} />
</Layout>
