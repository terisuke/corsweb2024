---
import { getCollection } from 'astro:content';
import { getNewsCategoryLabel } from '../../config/news-categories';
import { getCurrentLocale, getTranslations } from '../../utils/i18n';
import { safeJsonLd } from '../../utils/json-ld';

const currentLocale = getCurrentLocale(Astro.url);
const t = getTranslations(currentLocale);

const news =
  currentLocale === 'ja'
    ? (
        await getCollection('news', ({ data }) => {
          return import.meta.env.DEV || !data.isDraft;
        })
      )
        .sort((a, b) => {
          if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
          return new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime();
        })
        .slice(0, 6)
    : [];

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t.homeNews.title,
  itemListElement: news.map((entry, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: entry.data.title,
    url: entry.data.externalUrl || new URL(`/news/${entry.slug}/`, Astro.site).toString(),
  })),
};
---

{
  news.length > 0 && (
    <section class="py-20 sm:py-28" aria-labelledby="home-news-heading">
      <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
        <div class="flex flex-col gap-8 sm:gap-10">
          <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between" data-reveal>
            <div class="flex max-w-3xl flex-col gap-4">
              <p class="text-sm font-medium uppercase text-primary-600 dark:text-primary-400">
                {t.homeNews.eyebrow}
              </p>
              <h2 id="home-news-heading" class="type-heading text-3xl font-medium sm:text-4xl">
                {t.homeNews.title}
              </h2>
              <p class="type-copy text-lg text-primary-950/70 dark:text-primary-200/70">
                {t.homeNews.description}
              </p>
            </div>
            <div class="flex flex-wrap items-center gap-3">
              <a
                href="/news"
                class="type-action inline-flex min-h-[48px] w-fit items-center justify-center rounded-full border border-primary-950/20 px-5 py-3 text-base font-medium text-primary-950 transition hover:bg-primary-500/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:border-primary-200/20 dark:text-primary-200 dark:hover:bg-primary-400/10"
              >
                {t.homeNews.cta}
              </a>
              <a
                href="/news/press/"
                class="type-action inline-flex min-h-[48px] w-fit items-center justify-center rounded-full border border-primary-950/20 px-5 py-3 text-base font-medium text-primary-950 transition hover:bg-primary-500/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:border-primary-200/20 dark:text-primary-200 dark:hover:bg-primary-400/10"
              >
                プレスリリース
              </a>
            </div>
          </div>

          <div
            class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 sm:-mx-6 sm:gap-5 sm:px-6 lg:mx-0 lg:px-0"
            aria-label={t.homeNews.title}
          >
            {news.map((entry, index) => {
              const data = entry.data;
              const href = data.externalUrl || `/news/${entry.slug}/`;
              const isExternal = Boolean(data.externalUrl);
              const categoryLabel = getNewsCategoryLabel(data.category, 'ja');
              const formattedDate = new Date(data.publishedAt).toLocaleDateString('ja-JP', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              });

              return (
                <article
                  class="relative flex w-72 flex-none snap-start flex-col gap-4 rounded-3xl bg-primary-500/10 p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-md dark:bg-primary-400/10 sm:w-80 lg:w-96"
                  data-reveal
                  style={`--reveal-delay:${(0.08 + index * 0.06).toFixed(2)}s`}
                >
                  <div class="flex flex-wrap items-center gap-3 text-sm">
                    <span class="inline-flex w-fit rounded-full bg-primary-500/15 px-3 py-1 text-xs font-medium text-primary-950/70 dark:bg-primary-400/15 dark:text-primary-200/70">
                      {categoryLabel}
                    </span>
                    <time datetime={data.publishedAt.toISOString()} class="text-primary-950/50 dark:text-primary-200/50">
                      {formattedDate}
                    </time>
                  </div>

                  <div class="flex flex-1 flex-col gap-3">
                    <h3 class="type-heading line-clamp-2 text-lg font-medium">
                      <a
                        href={href}
                        target={isExternal ? '_blank' : undefined}
                        rel={isExternal ? 'noopener noreferrer' : undefined}
                        class="rounded-md outline-none after:absolute after:inset-0 focus-visible:ring-2 focus-visible:ring-primary-500"
                      >
                        {data.title}
                      </a>
                    </h3>
                    <p class="type-copy line-clamp-3 text-sm leading-6 text-primary-950/70 dark:text-primary-200/70">
                      {data.description}
                    </p>
                  </div>

                  <div class="mt-auto flex flex-wrap items-center gap-2 text-xs text-primary-950/50 dark:text-primary-200/50">
                    {data.source && <span>{data.source}</span>}
                    {isExternal && (
                      <span class="inline-flex items-center gap-1">
                        外部リンク
                        <span aria-hidden="true">↗</span>
                      </span>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </div>
      <script type="application/ld+json" set:html={safeJsonLd(itemListJsonLd)} is:inline />
    </section>
  )
}
