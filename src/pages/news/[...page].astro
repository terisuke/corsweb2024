---
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import NewsIndex from '../../components/news/NewsIndex.astro';
import Layout from '../../layouts/Layout.astro';
import { getJaTranslations } from '../../utils/i18n';

interface Props {
  page: Page<CollectionEntry<'news'>>;
}

// ja のニュース一覧。記事は news/ja/<slug>.md に置かれるため lang で絞る
// （非ja の翻訳記事は /[lang]/news 側が担当する）。
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const news = await getCollection('news', ({ data }) => {
    return data.lang === 'ja' && (import.meta.env.DEV || !data.isDraft);
  });

  const sortedNews = news.sort(
    (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime(),
  );

  return paginate(sortedNews, { pageSize: 12 });
};

const { page } = Astro.props;
const t = getJaTranslations();
---

<Layout
  description={t.meta.news.description}
  title={t.meta.news.title}
  availableLocales={['ja', 'en', 'zh', 'ko', 'es']}
>
  <NewsIndex page={page} />
</Layout>
