---
import Layout from '../layouts/Layout.astro';
import WorksIndex from '../components/works/WorksIndex.astro';
import { getJaTranslations } from '../utils/i18n';

// ja 版の実績一覧。本体は WorksIndex に集約し、非ja（/[lang]/works）と共有している。
const t = getJaTranslations();
---

<Layout
  description={t.meta.works.description}
  title={t.meta.works.title}
  availableLocales={['ja', 'en', 'zh', 'ko', 'es']}
>
  <WorksIndex />
</Layout>
