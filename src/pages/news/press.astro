---
import { getCollection } from 'astro:content';
import PressIndex from '../../components/news/PressIndex.astro';
import Layout from '../../layouts/Layout.astro';
import { getJaTranslations } from '../../utils/i18n';

// ja のプレスリリース一覧。記事は news/ja/<slug>.md に置かれるため lang で絞る。
const t = getJaTranslations();
const pressEntries = (
  await getCollection('news', ({ data }) => {
    return (
      data.lang === 'ja' && data.category === 'press' && (import.meta.env.DEV || !data.isDraft)
    );
  })
).sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());
---

<Layout
  description={t.meta.press.description}
  title={t.meta.press.title}
  availableLocales={['ja', 'en', 'zh', 'ko', 'es']}
>
  <PressIndex entries={pressEntries} />
</Layout>
