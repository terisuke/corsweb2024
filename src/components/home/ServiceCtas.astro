---
import { getCurrentLocale, getLocalizedUrl, getTranslations } from '../../utils/i18n';

const currentLocale = getCurrentLocale(Astro.url);
const t = getTranslations(currentLocale);
const contactHref = getLocalizedUrl('/contact', currentLocale);
---

<section class="py-16 sm:py-20" data-reveal>
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="flex flex-col gap-8 sm:gap-10">
      <h2 class="max-w-3xl text-3xl font-medium tracking-tight sm:text-4xl">
        {t.serviceCtas.heading}
      </h2>
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6">
        {
          t.serviceCtas.items.map((label, i) => (
            <li
              data-reveal
              style={`--reveal-delay:${(0.1 + i * 0.08).toFixed(2)}s`}
            >
              <a
                href={contactHref}
                class="flex min-h-[56px] items-center justify-between gap-4 rounded-2xl bg-primary-500/10 px-6 py-5 text-base font-medium text-primary-950 transition hover:bg-primary-500/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:bg-primary-400/10 dark:text-primary-100 dark:hover:bg-primary-400/20 dark:focus-visible:outline-primary-400"
              >
                <span>{label}</span>
                <svg
                  class="h-5 w-5 shrink-0 text-primary-600 dark:text-primary-300"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M4 10h12M11 5l5 5-5 5" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
