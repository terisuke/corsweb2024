---
import type { CollectionEntry } from 'astro:content';
import { getNewsCategoryLabel } from '../../config/news-categories';
import { getCurrentLocale, getLocalizedUrl, getTranslations } from '../../utils/i18n';
import { DATE_LOCALES, toCleanSlug } from '../../utils/content-i18n';

interface Props {
  entry: CollectionEntry<'news'>;
}

const { entry } = Astro.props;
const currentLocale = getCurrentLocale(Astro.url);
const t = getTranslations(currentLocale);
const data = entry.data;
const isExternal = Boolean(data.externalUrl);
// 記事は news/<lang>/<slug>.md に置かれ slug が `<lang>/<slug>` になるため、
// 内部リンクでは接頭辞を外して現在ロケールの記事 URL に向ける（外部リンクはそのまま）。
const href = data.externalUrl || getLocalizedUrl(`/news/${toCleanSlug(entry.slug)}/`, currentLocale);
const categoryLabel = getNewsCategoryLabel(data.category, currentLocale);
const formattedDate = new Date(data.publishedAt).toLocaleDateString(DATE_LOCALES[currentLocale], {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="group relative flex h-full flex-col gap-4 rounded-3xl bg-primary-500/10 p-6 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg dark:bg-primary-400/10">
  <div class="flex flex-wrap items-center gap-3 text-sm">
    <span class="inline-flex w-fit rounded-full bg-primary-500/15 px-3 py-1 text-xs font-medium text-primary-950/70 dark:bg-primary-400/15 dark:text-primary-200/70">
      {categoryLabel}
    </span>
    <time datetime={data.publishedAt.toISOString()} class="text-primary-950/50 dark:text-primary-200/50">
      {formattedDate}
    </time>
  </div>

  <div class="flex flex-1 flex-col gap-3">
    <h2 class="type-heading text-lg font-medium tracking-tight">
      <a
        href={href}
        target={isExternal ? '_blank' : undefined}
        rel={isExternal ? 'noopener noreferrer' : undefined}
        class="rounded-md outline-none after:absolute after:inset-0 focus-visible:ring-2 focus-visible:ring-primary-500"
      >
        {data.title}
      </a>
    </h2>
    <p class="type-copy text-sm leading-6 text-primary-950/70 dark:text-primary-200/70">
      {data.description}
    </p>
  </div>

  <div class="mt-auto flex flex-wrap items-center gap-2 text-xs text-primary-950/50 dark:text-primary-200/50">
    {data.source && <span>{data.source}</span>}
    {isExternal && (
      <span class="inline-flex items-center gap-1">
        {t.news.externalLabel}
        <span aria-hidden="true">↗</span>
      </span>
    )}
  </div>
</article>
