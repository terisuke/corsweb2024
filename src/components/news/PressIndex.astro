---
import type { CollectionEntry } from 'astro:content';
import NewsCard from './NewsCard.astro';
import { getNewsCategoryLabel } from '../../config/news-categories';
import { getContactUrl } from '../../config/site';
import { getCurrentLocale, getLocalizedUrl, getTranslations } from '../../utils/i18n';
import { toCleanSlug } from '../../utils/content-i18n';
import { safeJsonLd } from '../../utils/json-ld';

// /news/press（ja）と /[lang]/news/press（非ja）で共有するプレスリリース一覧本体。
interface Props {
  entries: CollectionEntry<'news'>[];
}

const { entries } = Astro.props;
const currentLocale = getCurrentLocale(Astro.url);
const t = getTranslations(currentLocale);

// チャット窓口 (/contact/chat/) は ja にしか存在しないため、非ja は各言語の /contact に intent 付きで送る。
const pressContactHref =
  currentLocale === 'ja'
    ? '/contact/chat/?intent=press-speaking-other&source=press-page'
    : getContactUrl(currentLocale, { intent: 'press-speaking-other', source: 'press-page' });

const pageUrl = new URL(getLocalizedUrl('/news/press/', currentLocale), Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: getNewsCategoryLabel('press', currentLocale),
  description: t.meta.press.description,
  inLanguage: currentLocale,
  url: pageUrl,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: entries.map((entry, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: entry.data.title,
      url:
        entry.data.externalUrl ||
        new URL(
          getLocalizedUrl(`/news/${toCleanSlug(entry.slug)}/`, currentLocale),
          Astro.site,
        ).toString(),
    })),
  },
};
---

<main class="mx-auto max-w-2xl px-4 py-16 sm:px-6 sm:py-20 lg:max-w-7xl lg:px-8">
  <div class="flex max-w-3xl flex-col gap-4 pb-10 sm:pb-12">
    <p class="text-sm font-medium uppercase tracking-widest text-primary-600 dark:text-primary-400">{t.press.eyebrow}</p>
    <h1 class="type-heading text-3xl font-medium tracking-tight sm:text-4xl md:text-5xl">{t.press.title}</h1>
    <p class="type-copy text-lg text-primary-950/70 dark:text-primary-200/70">
      {t.press.intro}
    </p>
    <div class="flex flex-wrap gap-4 text-sm">
      <a href={getLocalizedUrl('/news/', currentLocale)} class="text-primary-950/60 underline-offset-4 hover:text-primary-950 hover:underline dark:text-primary-200/60 dark:hover:text-primary-100">{t.press.newsListLabel}</a>
      <a href={getLocalizedUrl('/news.xml', currentLocale)} class="text-primary-950/60 underline-offset-4 hover:text-primary-950 hover:underline dark:text-primary-200/60 dark:hover:text-primary-100">{t.press.rssLabel}</a>
    </div>
  </div>

  {entries.length > 0 ? (
    <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {entries.map((entry) => (
        <li>
          <NewsCard entry={entry} />
        </li>
      ))}
    </ul>
  ) : (
    <div class="flex max-w-3xl flex-col gap-4 rounded-3xl bg-primary-500/10 p-6 dark:bg-primary-400/10">
      <p class="type-copy text-primary-950/70 dark:text-primary-200/70">{t.press.empty}</p>
      <a href={pressContactHref} class="type-action inline-flex w-fit items-center gap-1 text-sm text-primary-950/60 underline-offset-4 hover:text-primary-950 hover:underline dark:text-primary-200/60 dark:hover:text-primary-100">
        {t.press.contactLabel}
      </a>
    </div>
  )}
</main>

<script type="application/ld+json" set:html={safeJsonLd(jsonLd)} is:inline />
